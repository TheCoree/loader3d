# All values come from .env (passed into the container by docker-compose.yml).
#
# SITE_ADDRESS = domain (loader.example.com) -> Caddy obtains a Let's Encrypt certificate
#                and redirects HTTP to HTTPS; ports 80 and 443 must be reachable from the internet.
# SITE_ADDRESS = :80                          -> plain HTTP, e.g. behind an existing reverse proxy.
# Several names are allowed: "example.com, www.example.com".
# The text after the first colon in {$SITE_ADDRESS::80} is the fallback (":80").

{
	admin off
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Security headers. HSTS: browsers stay on HTTPS (also www and mail, which have certificates too).
	# CSP: scripts, styles and requests only from the site itself (plus Google Fonts); 'unsafe-eval' because
	# pdfmake (the PDF export) compiles code at run time; inline styles for React's style attributes; no
	# framing of the site anywhere (clickjacking).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; frame-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	# Backend (backend/, the "api" service). Same origin as the frontend: no CORS, and the
	# refresh-token cookie stays first-party.
	handle /api/* {
		request_body {
			max_size 5MB
		}
		reverse_proxy api:8000
	}

	handle {
		root * /srv

		# Vite puts content-hashed bundles into /assets: safe to cache forever.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# Public images of the landing page: cached for a day.
		@landing path /landing/*
		header @landing Cache-Control "public, max-age=86400"

		# One address per page: /kalkulyator/ldm/ -> /kalkulyator/ldm (the app has no addresses ending in /).
		@slash path_regexp slash ^(/.+)/$
		redir @slash {re.slash.1}{?query} permanent

		# HTML must be revalidated so a new deploy is picked up immediately: the pages themselves and every
		# route of the app (no file by that name: try_files below answers it with app.html). Without the
		# header browsers keep such a page by heuristics and go on running the previous bundle after a deploy.
		@html path / *.html
		header @html Cache-Control "no-cache"
		@route not file
		header @route Cache-Control "no-cache"

		# index.html is the landing page prerendered for search engines (scripts/prerender.mjs), and so are
		# the calculators: /kalkulyator/ldm is kalkulyator/ldm.html. Every other route of the app gets the
		# empty shell app.html.
		@root path /
		rewrite @root /index.html
		try_files {path} {path}.html /app.html
		file_server
	}
}

# REDIRECT_ADDRESS = other names of the site ("www.example.com, mail.example.com") -> their own
# certificates and a permanent redirect to SITE_URL. The mail server (compose service "mail") uses the
# certificate Caddy gets here for its name. The default http://redirect.localhost matches no request.
{$REDIRECT_ADDRESS:http://redirect.localhost} {
	redir {$SITE_URL}{uri} permanent
}
