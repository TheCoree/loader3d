# Loader3D deployment settings. Copy to .env and edit:  cp .env.example .env
# .env is not committed (see .gitignore).

# --- Compose ------------------------------------------------------------------
# Prefix for the container, image and volume names.
COMPOSE_PROJECT_NAME=loader3d

# --- Site ---------------------------------------------------------------------
# Domain  -> automatic HTTPS (Let's Encrypt). The domain's DNS A/AAAA record must point
#            to this server and ports 80/443 must be open; keep HTTP_PORT=80, HTTPS_PORT=443.
#            Several names: SITE_ADDRESS="example.com, www.example.com"
# :80     -> plain HTTP without certificates (open by IP, or behind your own reverse proxy).
SITE_ADDRESS=:80
# Public address of the site, e.g. https://loader.example.com (no trailing slash). The landing page
# is prerendered with it for search engines: canonical link, Open Graph image URL, sitemap.xml.
# Empty: none of them (they need absolute URLs). Changing it needs: docker compose up -d --build
SITE_URL=
# Other names of the site, e.g. "www.example.com, mail.example.com": each gets HTTPS and a permanent
# redirect to SITE_URL (set SITE_URL too). The own mail server's MAIL_HOSTNAME must be listed here:
# its certificate comes from Caddy. Empty: no other names.
REDIRECT_ADDRESS=

# --- Tariffs ------------------------------------------------------------------
# true:  subscription tiers «Старт» / «Pro» / «Индивидуальный» — pricing on the site, the tariff choice on
#        registration, limits of plans, vehicles and cargo, tariffs in the account and the admin panel.
# false: no tariffs anywhere (the site and the app do not mention them) and nothing is limited.
# Read by the API and built into the site: after changing it run  docker compose up -d --build
TIERS_ENABLED=false

# --- Published ports ----------------------------------------------------------
# Host side of the port mapping: "PORT" or "IP:PORT".
# Behind an existing reverse proxy on the same host, publish on localhost only, e.g.
#   HTTP_PORT=127.0.0.1:8080
#   HTTPS_PORT=127.0.0.1:8443
# and proxy to http://127.0.0.1:8080 (keep SITE_ADDRESS=:80).
HTTP_PORT=80
HTTPS_PORT=443

# --- Accounts and sessions (api) ------------------------------------------------
# Required. Signs the login tokens: a random string of 32+ characters, e.g. the output of
#   openssl rand -hex 32
# Changing it logs everybody out.
JWT_SECRET=
# Lifetime of an access token (minutes) and of a login session without activity (days).
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# false: nobody can create new accounts (existing ones keep working; admins can still add them).
REGISTRATION_OPEN=true
# true: a new account confirms its email with a 6-digit code before it can open plans.
# false: accounts count as confirmed right away.
EMAIL_VERIFICATION=true
# How the codes (email confirmation, password reset) are sent:
#   console: printed to the API log (docker compose logs api) until there is a mailbox for the domain;
#   smtp:    through an SMTP server (SMTP_* below): a mail provider's or the own one (see "Own mail
#            server" below: SMTP_HOST=$MAIL_HOSTNAME, port 465, ssl, the login of a mailbox there).
# Check the settings with:  docker compose exec api python -m app send-test-mail you@example.com
MAIL_BACKEND=console
# Sender of the letters; its domain needs SPF and DKIM records from the provider, or letters land in spam.
MAIL_FROM="Loader3D <noreply@example.com>"
# Submission server of the provider, e.g. smtp.yandex.ru, smtp.mail.ru, smtp.resend.com.
SMTP_HOST=
# 465 with SMTP_SECURITY=ssl (TLS from the start) or 587 with starttls; none: no encryption (local relay).
SMTP_PORT=465
SMTP_SECURITY=ssl
# Login of the mailbox (often the full address) and its password: for Yandex / Mail.ru an
# app password, not the password of the account. Empty username: no login.
SMTP_USERNAME=
SMTP_PASSWORD=
# Whose X-Forwarded-For the API trusts for the visitor's IP (login/registration limits, the sessions
# list). * is right here: the api container is reachable only through Caddy. If Caddy itself sits
# behind another proxy (SITE_ADDRESS=:80), set trusted_proxies in deploy/Caddyfile as well.
FORWARDED_ALLOW_IPS=*
# The session cookie gets the Secure flag by itself when the site is opened over HTTPS.
# Admin panel (/admin): grant access to an existing account with
#   docker compose exec api python -m app make-admin you@example.com
# (--revoke takes it away). Admins manage users, their tariffs and requests from the site.

# --- Own mail server (optional) -----------------------------------------------------
# mail: also start the "mail" service (docker-mailserver) — mailboxes of the domain and sending without
# a mail provider. It needs DNS records (A, MX, SPF, DKIM, DMARC) and a PTR record of the server's IP;
# the steps are in README ("Своя почта"). Empty: no mail server.
COMPOSE_PROFILES=
# Name of the mail server: its A record points to this server, the domain's MX points to it, and the PTR
# of the server's IP returns it. Add it to REDIRECT_ADDRESS (Caddy gets its certificate).
MAIL_HOSTNAME=mail.example.com
# docker-mailserver image version (ghcr.io/docker-mailserver/docker-mailserver:<v>).
DMS_VERSION=17

# --- Database (Postgres) --------------------------------------------------------
# Required. Used when the database is created on the first start; changing it later does not
# change the password inside an existing database (docker compose exec db psql ... ALTER USER).
POSTGRES_PASSWORD=
POSTGRES_DB=loader3d
POSTGRES_USER=loader3d

# --- Container logs -----------------------------------------------------------
# Docker json-file log rotation: size of one file and how many files to keep.
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# --- Build --------------------------------------------------------------------
# Base image versions (Docker Hub tags node:<v>-alpine, caddy:<v>-alpine, python:<v>-slim).
# After changing them run: docker compose up -d --build
NODE_VERSION=24
CADDY_VERSION=2
PYTHON_VERSION=3.14
# Postgres major version (postgres:<v>-alpine). 18 or newer: the data volume layout depends on it.
# Changing the major version of an existing database needs a dump and restore.
POSTGRES_VERSION=18
